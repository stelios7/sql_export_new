<Window
	x:Class="SQL_Export.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:SQL_Export.Src"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SQL_Export"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="SQL Extract"
	Width="400"
	Height="500"
	Icon="cells.ico"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">
	<Window.Resources>
		<Style BasedOn="{StaticResource SecondaryButton}" TargetType="Button" />
		<converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
		<!--<Style TargetType="Button" BasedOn="{StaticResource MainButton}" />-->

	</Window.Resources>
	<Grid HorizontalAlignment="Center">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="30" />
		</Grid.RowDefinitions>
		<WrapPanel
			Grid.Row="0"
			Margin="0"
			HorizontalAlignment="Stretch"
			Orientation="Vertical">
			<GroupBox>
				<GroupBox.Header>
					<TextBlock Style="{StaticResource GroupBoxTextBlock}" Text="Σύνδεση" />
				</GroupBox.Header>
				<StackPanel Height="auto" Orientation="Vertical">
					<StackPanel>
						<Label Content="Server Name:" />
						<TextBox Text="{Binding SelectedSqlInstance, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>

					<StackPanel>
						<Label Content="Login:" />
						<TextBox Text="{Binding LoginSQL, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>

					<StackPanel>
						<Label Content="Password:" />
						<TextBox Text="{Binding PasswordSQL, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</StackPanel>
			</GroupBox>

			<!--  LIST DATABASE  -->
			<GroupBox x:Name="ListDatabaseGroupBox">
				<GroupBox.Header>
					<RadioButton
						Content="Επιλογή Βάσης Δεδομένων από λίστα:"
						GroupName="Databases"
						IsChecked="{Binding IsLocalDatabase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanNegationConverter}}"
						IsEnabled="{Binding}"
						Style="{StaticResource GroupBoxRadioButton}" />
				</GroupBox.Header>

				<StackPanel IsEnabled="{Binding IsLocalDatabase, Converter={StaticResource BooleanNegationConverter}}">
					<Label Content="Database:" />
					<ComboBox
						Width="200"
						VerticalContentAlignment="Center"
						IsEnabled="{Binding IsComboBoxEnabled}"
						ItemsSource="{Binding SqlDatabases}"
						MaxDropDownHeight="300"
						SelectedItem="{Binding SelectedSQLDatabase}">
						<ComboBox.ItemsPanel>
							<ItemsPanelTemplate>
								<VirtualizingStackPanel />
							</ItemsPanelTemplate>
						</ComboBox.ItemsPanel>
					</ComboBox>

				</StackPanel>
			</GroupBox>


			<!--  LOCAL DATABASE FILE  -->
			<GroupBox x:Name="LocalDatabaseGroupBox">
				<GroupBox.Header>
					<RadioButton
						Content="Επιλογή Βάσης Δεδομένων από αρχείο:"
						GroupName="Databases"
						IsChecked="{Binding IsLocalDatabase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						Style="{StaticResource GroupBoxRadioButton}" />
				</GroupBox.Header>

				<StackPanel
					Height="auto"
					IsEnabled="{Binding IsLocalDatabase}"
					Orientation="Vertical">
					<StackPanel>
						<Label Content="Database Name:" />
						<TextBox Text="{Binding DatabaseToRestoreName, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
					<StackPanel
						Margin="0"
						HorizontalAlignment="Center"
						Orientation="Horizontal">
						<TextBox
							Width="300"
							FontSize="12"
							Text="{Binding DatabaseToRestore, UpdateSourceTrigger=PropertyChanged}" />
						<Button
							x:Name="btnSelectDatabaseToRestore"
							Command="{Binding SelectLocalDatabase_command}"
							Style="{StaticResource FolderButtonStyle}" />
					</StackPanel>
					<Button
						x:Name="btnRestoreDB"
						Command="{Binding RestoreDB_Command}"
						Content="Restore"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>
			</GroupBox>

			<GroupBox Margin="0" Padding="0">
				<GroupBox.Header>
					<TextBlock Style="{StaticResource GroupBoxTextBlock}" Text="Επιλογές" />
				</GroupBox.Header>
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

					<Button
						Command="{Binding ConnectSQL_Command}"
						Content="Connect"
						ToolTip="Άνοιγμα σύνδεσης SQL" />
					<Button
						Command="{Binding DisconnectSQL_Command}"
						Content="Disconnect"
						ToolTip="Κλείσιμο σύνδεσης SQL" />
					<Button
						Command="{Binding ExtractData_Command}"
						Content="Extract"
						ToolTip="Επιλογή φακέλου για εξαγωγή αρχείων Excel" />
				</StackPanel>
			</GroupBox>
		</WrapPanel>
		<StackPanel
			Grid.Row="1"
			HorizontalAlignment="Left"
			Orientation="Horizontal">
			<StackPanel.Resources>
				<Style BasedOn="{StaticResource StatusLabel}" TargetType="Label" />
			</StackPanel.Resources>
			<Label Content="Status: " />
			<Label Content="{Binding ConnectionState}" />
		</StackPanel>

	</Grid>
</Window>